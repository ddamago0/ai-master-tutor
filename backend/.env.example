# Application Configuration
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
PROJECT_NAME="AI Master Tutor"

# Security & CORS
CORS_ORIGINS=["http://localhost:3000","chrome-extension://*"]

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_master_tutor

# Semantic Cache (ChromaDB Local Storage Path)
CHROMA_PERSIST_DIRECTORY=./chroma_data

# Zero-Cost LLM Gateway API Keys
GEMINI_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=

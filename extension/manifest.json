{
  "manifest_version": 3,
  "name": "AI Master Tutor - Extractor",
  "version": "0.1.0",
  "description": "Extractor de contenido de estudio del DOM (Moodle, Q10, Canvas) para AI Master Tutor",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "AI Master Tutor Extractor"
  },
  "background": {
    "service_worker": "src/background/index.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.js"]
    }
  ]
}
